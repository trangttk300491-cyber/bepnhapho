@model List<CongThuc>
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Chờ duyệt công thức"; }
<section class="page-section"><div class="container"><div class="section-heading"><p class="eyebrow">KHU VỰC QUẢN TRỊ</p><h1>Công thức chờ duyệt</h1><p class="text-muted">Đọc nội dung trước khi duyệt hoặc từ chối bài gửi.</p></div>
    @if(Model.Count == 0){<div class="empty-state"><h3>Hộp chờ đã trống</h3><p>Hiện chưa có công thức cần kiểm duyệt.</p><a asp-action="Recipes" class="btn btn-outline-dark">Xem tất cả công thức</a></div>}
    else{<div class="admin-review-list">@foreach(var recipe in Model){<article class="paper-card admin-review-card"><div class="admin-review-photo"><img src="@Url.RecipeImage(recipe.AnhDaiDien)" asp-append-version="true" alt="@recipe.TieuDe" /></div><div class="admin-review-content"><div class="recipe-meta"><span>@recipe.DanhMuc.TenDanhMuc</span><span>Gửi bởi @recipe.NguoiDung.HoTen</span><span>@recipe.NgayTao.ToLocalTime().ToString("dd/MM/yyyy")</span></div><h2><a asp-controller="Recipe" asp-action="Details" asp-route-id="@recipe.MaCongThuc">@recipe.TieuDe</a></h2><p>@recipe.MoTa</p><div class="review-fields"><div><strong>Nguyên liệu</strong><ul>@foreach(var line in recipe.NguyenLieus){<li>@line.TenNguyenLieu — @line.DinhLuong</li>}</ul></div><div><strong>Các bước</strong><ol>@foreach(var step in recipe.BuocThucHiens.OrderBy(x => x.SoThuTu)){<li>@step.NoiDung</li>}</ol></div></div><div class="review-actions"><form asp-action="Review" method="post" class="d-inline"><input type="hidden" name="MaCongThuc" value="@recipe.MaCongThuc" /><input type="hidden" name="decision" value="approve" /><button type="submit" class="btn btn-gold">Duyệt công thức</button></form><form asp-action="Review" method="post" class="reject-form"><input type="hidden" name="MaCongThuc" value="@recipe.MaCongThuc" /><input type="hidden" name="decision" value="reject" /><label class="visually-hidden" for="reason-@recipe.MaCongThuc">Lý do từ chối</label><input id="reason-@recipe.MaCongThuc" name="LyDoTuChoi" maxlength="300" minlength="5" required class="form-control" placeholder="Lý do từ chối (5–300 ký tự)" /><button class="btn btn-outline-danger" type="submit">Từ chối</button></form></div></div></article>}</div>}
</div></section>
