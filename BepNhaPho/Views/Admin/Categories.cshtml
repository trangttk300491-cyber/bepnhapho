@model List<DanhMuc>
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Quản lý danh mục"; }
<section class="page-section"><div class="container"><div class="section-heading"><p class="eyebrow">KHU VỰC QUẢN TRỊ</p><h1>Danh mục món ăn</h1><p class="text-muted">Thêm, đổi tên hoặc xóa danh mục chưa có công thức.</p></div><div class="row g-4"><div class="col-lg-4"><form asp-action="CreateCategory" method="post" class="paper-card"><h2 class="form-card-title">Thêm danh mục</h2><label class="form-label" for="new-name">Tên danh mục</label><input class="form-control mb-3" id="new-name" name="TenDanhMuc" maxlength="100" required /><button type="submit" class="btn btn-gold">Thêm danh mục</button></form></div><div class="col-lg-8"><div class="paper-card category-list">@foreach(var category in Model){<div class="category-row"><form asp-action="EditCategory" method="post" class="category-edit"><input type="hidden" name="MaDanhMuc" value="@category.MaDanhMuc" /><label class="visually-hidden" for="category-@category.MaDanhMuc">Tên danh mục</label><input id="category-@category.MaDanhMuc" name="TenDanhMuc" value="@category.TenDanhMuc" maxlength="100" required class="form-control" /><button class="btn btn-sm btn-outline-dark" type="submit">Lưu</button></form><form asp-action="DeleteCategory" asp-route-id="@category.MaDanhMuc" method="post" onsubmit="return confirm('Xóa danh mục này?')"><button class="btn btn-sm btn-outline-danger" type="submit">Xóa</button></form></div>}</div></div></div></div></section>
