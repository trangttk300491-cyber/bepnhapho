@model List<NguoiDung>
@using System.Security.Claims
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Quản lý người dùng"; var currentId = User.FindFirstValue(ClaimTypes.NameIdentifier); }
<section class="page-section"><div class="container"><div class="section-heading"><p class="eyebrow">KHU VỰC QUẢN TRỊ</p><h1>Người dùng</h1><p class="text-muted">Theo dõi tài khoản và trạng thái truy cập.</p></div><div class="table-responsive paper-card"><table class="table align-middle recipe-table"><thead><tr><th>Họ tên</th><th>Email</th><th>Vai trò</th><th>Ngày tham gia</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach(var person in Model){<tr><td>@person.HoTen @(person.MaNguoiDung.ToString() == currentId ? "(Bạn)" : "")</td><td>@person.Email</td><td>@(person.VaiTro == "QuanTri" ? "Quản trị viên" : "Thành viên")</td><td>@person.NgayTao.ToLocalTime().ToString("dd/MM/yyyy")</td><td><span class="status-badge @(person.HoatDong ? "DaDuyet" : "BiTuChoi")">@(person.HoatDong ? "Đang hoạt động" : "Đã khóa")</span></td><td>@if(person.MaNguoiDung.ToString() != currentId){<form asp-action="ToggleUserStatus" asp-route-id="@person.MaNguoiDung" method="post"><button class="btn btn-sm @(person.HoatDong ? "btn-outline-danger" : "btn-outline-success")" type="submit">@(person.HoatDong ? "Khóa" : "Mở khóa")</button></form>}</td></tr>}</tbody></table></div></div></section>
