@model AdminStatisticsViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Thống kê";
}

<section class="page-section">
    <div class="container">
        <div class="section-heading">
            <p class="eyebrow">KHU VỰC QUẢN TRỊ</p>
            <h1>Thống kê hệ thống</h1>
            <p class="text-muted">Theo dõi số lượng công thức, danh mục và tài khoản hiện có.</p>
        </div>

        <div class="admin-stats-grid">
            <div class="paper-card admin-stat-card">
                <h2>Tổng công thức</h2>
                <strong data-stat="recipes-total">@Model.TotalRecipes</strong>
                <p>Công thức chưa xóa mềm</p>
            </div>
            <div class="paper-card admin-stat-card">
                <h2>Chờ duyệt</h2>
                <strong data-stat="recipes-pending">@Model.PendingRecipes</strong>
                <a asp-action="Pending">Xem bài chờ duyệt <span aria-hidden="true">↗</span></a>
            </div>
            <div class="paper-card admin-stat-card">
                <h2>Đã duyệt</h2>
                <strong data-stat="recipes-approved">@Model.ApprovedRecipes</strong>
                <a asp-action="Recipes" asp-route-status="DaDuyet">Xem bài đã duyệt <span aria-hidden="true">↗</span></a>
            </div>
            <div class="paper-card admin-stat-card">
                <h2>Bị từ chối</h2>
                <strong data-stat="recipes-rejected">@Model.RejectedRecipes</strong>
                <a asp-action="Recipes" asp-route-status="BiTuChoi">Xem bài bị từ chối <span aria-hidden="true">↗</span></a>
            </div>
        </div>

        <section class="paper-card admin-user-summary" aria-labelledby="user-stat-heading">
            <div><h2 id="user-stat-heading" class="form-card-title">Tài khoản người dùng</h2><p class="text-muted mb-0">Bao gồm thành viên và quản trị viên.</p></div>
            <dl class="admin-user-counts">
                <div><dt>Tổng tài khoản</dt><dd data-stat="users-total">@Model.TotalUsers</dd></div>
                <div><dt>Đang hoạt động</dt><dd data-stat="users-active">@Model.ActiveUsers</dd></div>
                <div><dt>Đã khóa</dt><dd data-stat="users-locked">@Model.LockedUsers</dd></div>
            </dl>
        </section>

        <section class="paper-card admin-category-stats" aria-labelledby="category-stat-heading">
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-4">
                <div><h2 id="category-stat-heading" class="form-card-title">Công thức theo danh mục</h2><p class="text-muted mb-0">Có @Model.Categories.Count danh mục chưa xóa mềm. Danh mục chưa có bài hiển thị số 0.</p></div>
                <a class="text-link" asp-action="Categories">Quản lý danh mục <span aria-hidden="true">↗</span></a>
            </div>
            <div class="table-responsive">
                <table class="table align-middle recipe-table">
                    <caption class="visually-hidden">Số công thức chưa xóa mềm theo danh mục và trạng thái duyệt</caption>
                    <thead><tr><th scope="col">Danh mục</th><th scope="col" class="text-end">Chờ duyệt</th><th scope="col" class="text-end">Đã duyệt</th><th scope="col" class="text-end">Bị từ chối</th><th scope="col" class="text-end">Tổng</th></tr></thead>
                    <tbody>
                        @if (Model.Categories.Count == 0)
                        {
                            <tr><td colspan="5" class="table-empty-message">Chưa có danh mục nào để thống kê.</td></tr>
                        }
                        else
                        {
                            @foreach (var category in Model.Categories)
                            {
                                <tr><th scope="row">@category.Name</th><td class="text-end">@category.PendingRecipes</td><td class="text-end">@category.ApprovedRecipes</td><td class="text-end">@category.RejectedRecipes</td><td class="text-end fw-bold">@category.TotalRecipes</td></tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </section>
        <p class="admin-stats-note">Số liệu được tổng hợp khi mở hoặc tải lại trang. Công thức và danh mục đã xóa mềm không được tính.</p>
    </div>
</section>
