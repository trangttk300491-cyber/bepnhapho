@model List<CongThuc>
@{ ViewData["Title"] = "Công thức của tôi"; }
<section class="page-section"><div class="container"><div class="section-heading d-flex flex-wrap align-items-end justify-content-between gap-3"><div><p class="eyebrow">GÓC BẾP CỦA BẠN</p><h1>Công thức của tôi</h1><p class="text-muted">Theo dõi trạng thái các món bạn đã chia sẻ.</p></div><a asp-action="Create" class="btn btn-gold">+ Đăng công thức</a></div>
    @if(Model.Count == 0){<div class="empty-state"><h3>Bếp nhà mình đang chờ món đầu tiên</h3><p>Chia sẻ công thức bạn yêu thích nhé.</p><a asp-action="Create" class="btn btn-gold">Đăng công thức</a></div>}
    else{<div class="table-responsive paper-card"><table class="table align-middle recipe-table"><thead><tr><th>Món ăn</th><th>Danh mục</th><th>Trạng thái</th><th>Ngày đăng</th><th></th></tr></thead><tbody>
        @foreach(var recipe in Model){<tr><td><div class="table-recipe"><img src="@Url.RecipeImage(recipe.AnhDaiDien)" asp-append-version="true" alt="" /><div><a asp-action="Details" asp-route-id="@recipe.MaCongThuc">@recipe.TieuDe</a>@if(recipe.TrangThai == "BiTuChoi" && !string.IsNullOrWhiteSpace(recipe.LyDoTuChoi)){<small class="rejection-note">Lý do: @recipe.LyDoTuChoi</small>}</div></div></td><td>@recipe.DanhMuc.TenDanhMuc</td><td><span class="status-badge @recipe.TrangThai">@(recipe.TrangThai == "ChoDuyet" ? "Chờ duyệt" : recipe.TrangThai == "DaDuyet" ? "Đã duyệt" : "Bị từ chối")</span></td><td>@recipe.NgayTao.ToLocalTime().ToString("dd/MM/yyyy")</td><td><div class="table-actions"><a class="btn btn-sm btn-outline-dark" asp-action="Edit" asp-route-id="@recipe.MaCongThuc">Sửa</a><form asp-action="Delete" asp-route-id="@recipe.MaCongThuc" method="post" onsubmit="return confirm('Ẩn công thức khỏi website? Công thức và dữ liệu liên quan sẽ được giữ lại.')"><button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button></form></div></td></tr>}
    </tbody></table></div>}
</div></section>
