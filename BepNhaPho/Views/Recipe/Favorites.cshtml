@model List<CongThuc>
@{ ViewData["Title"] = "Công thức đã lưu"; }
<section class="page-section"><div class="container"><div class="section-heading"><p class="eyebrow">DÀNH RIÊNG CHO BẠN</p><h1>Công thức đã lưu</h1><p class="text-muted">Những món bạn muốn nấu lại.</p></div>
    <div class="empty-state" data-favorites-empty hidden="@(Model.Count > 0)"><span class="empty-mark" aria-hidden="true">♥</span><h3>Bạn chưa lưu công thức nào</h3><p>Chạm vào trái tim ở món bạn thích để lưu lại.</p><a asp-action="Index" class="btn btn-gold">Khám phá công thức</a></div>
    @if(Model.Count > 0){<div class="row g-4 recipe-grid" data-favorites-grid>@foreach(var recipe in Model){<div class="col-sm-6 col-lg-4"><article class="recipe-card h-100"><a asp-action="Details" asp-route-id="@recipe.MaCongThuc" class="recipe-photo-wrap"><img class="recipe-photo" src="@Url.RecipeImage(recipe.AnhDaiDien)" asp-append-version="true" alt="@recipe.TieuDe" loading="lazy" /><span class="category-pill">@recipe.DanhMuc.TenDanhMuc</span></a><div class="recipe-card-body"><div class="recipe-meta"><span>@recipe.ThoiGianNauPhut phút</span><span>@recipe.KhauPhan khẩu phần</span></div><h3><a asp-action="Details" asp-route-id="@recipe.MaCongThuc">@recipe.TieuDe</a></h3><p>@(recipe.MoTa.Length > 110 ? recipe.MoTa[..107] + "…" : recipe.MoTa)</p><div class="recipe-card-foot"><span>Đã lưu</span><button class="heart-button is-favorite" type="button" data-favorite-toggle data-recipe-id="@recipe.MaCongThuc" aria-label="Bỏ khỏi yêu thích" aria-pressed="true">♥</button></div></div></article></div>}</div>}
</div></section>
