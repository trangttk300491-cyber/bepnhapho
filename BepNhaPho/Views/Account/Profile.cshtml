@model ProfileViewModel
@{ ViewData["Title"] = "Hồ sơ cá nhân"; }
<section class="page-section"><div class="container form-container"><div class="section-heading"><p class="eyebrow">TÀI KHOẢN CỦA BẠN</p><h1>Hồ sơ cá nhân</h1><p class="text-muted">Cập nhật tên hiển thị và bảo vệ tài khoản.</p></div><div class="row g-4"><div class="col-lg-6"><form asp-action="Profile" method="post" class="paper-card"><h2 class="form-card-title">Thông tin cá nhân</h2><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="mb-3"><label asp-for="HoTen" class="form-label">Họ và tên</label><input asp-for="HoTen" class="form-control" /><span asp-validation-for="HoTen" class="field-error"></span></div><div class="mb-4"><label asp-for="Email" class="form-label">Email</label><input asp-for="Email" class="form-control" readonly /><small class="form-hint">Email dùng để đăng nhập.</small></div><button class="btn btn-gold" type="submit">Lưu hồ sơ</button></form></div><div class="col-lg-6"><form asp-action="ChangePassword" method="post" class="paper-card"><h2 class="form-card-title">Đổi mật khẩu</h2><div class="mb-3"><label class="form-label" for="MatKhauCu">Mật khẩu hiện tại</label><input class="form-control" id="MatKhauCu" name="MatKhauCu" type="password" autocomplete="current-password" /><span class="field-error">@Html.ValidationMessage("MatKhauCu")</span></div><div class="mb-3"><label class="form-label" for="MatKhauMoi">Mật khẩu mới</label><input class="form-control" id="MatKhauMoi" name="MatKhauMoi" type="password" autocomplete="new-password" /><span class="field-error">@Html.ValidationMessage("MatKhauMoi")</span></div><div class="mb-4"><label class="form-label" for="NhapLaiMatKhau">Nhập lại mật khẩu mới</label><input class="form-control" id="NhapLaiMatKhau" name="NhapLaiMatKhau" type="password" autocomplete="new-password" /><span class="field-error">@Html.ValidationMessage("NhapLaiMatKhau")</span></div><button class="btn btn-outline-dark" type="submit">Đổi mật khẩu</button></form></div></div></div></section>
