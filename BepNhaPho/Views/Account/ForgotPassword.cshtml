@model ForgotPasswordViewModel
@{ ViewData["Title"] = "Quên mật khẩu"; }
<section class="auth-section"><div class="container auth-grid"><div class="auth-story"><p class="eyebrow">ĐỪNG LO, CHUYỆN NHỎ</p><h1>Mình sẽ giúp bạn<br /><em>mở lại gian bếp.</em></h1><p>Nhập email tài khoản để chuyển sang bước đặt mật khẩu mới.</p></div><div class="auth-card"><p class="eyebrow">KHÔI PHỤC TÀI KHOẢN</p><h2>Quên mật khẩu</h2><form asp-action="ForgotPassword" method="post"><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="mb-4"><label asp-for="Email" class="form-label">Email đã đăng ký</label><input asp-for="Email" class="form-control" autocomplete="email" /><span asp-validation-for="Email" class="field-error"></span></div><button class="btn btn-gold btn-lg w-100" type="submit">Tiếp tục</button></form><p class="auth-switch"><a asp-action="Login">← Trở lại đăng nhập</a></p></div></div></section>
