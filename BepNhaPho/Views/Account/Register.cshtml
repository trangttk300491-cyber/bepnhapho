@model RegisterViewModel
@{ ViewData["Title"] = "Đăng ký"; }
<section class="auth-section"><div class="container auth-grid"><div class="auth-story"><p class="eyebrow">MỖI CĂN BẾP, MỘT CÂU CHUYỆN</p><h1>Chào mừng bạn<br /><em>đến với bàn ăn.</em></h1><p>Nơi những công thức gia đình được lưu giữ và chia sẻ bằng tất cả sự thân tình.</p></div><div class="auth-card"><p class="eyebrow">BẮT ĐẦU HÔM NAY</p><h2>Tạo tài khoản</h2><form asp-action="Register" method="post"><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="mb-3"><label asp-for="HoTen" class="form-label">Họ và tên</label><input asp-for="HoTen" class="form-control" autocomplete="name" /><span asp-validation-for="HoTen" class="field-error"></span></div><div class="mb-3"><label asp-for="Email" class="form-label">Email</label><input asp-for="Email" class="form-control" autocomplete="email" /><span asp-validation-for="Email" class="field-error"></span></div><div class="mb-3"><label asp-for="MatKhau" class="form-label">Mật khẩu</label><input asp-for="MatKhau" type="password" class="form-control" autocomplete="new-password" /><span asp-validation-for="MatKhau" class="field-error"></span><small class="form-hint">Ít nhất 8 ký tự, gồm chữ và số.</small></div><div class="mb-4"><label asp-for="NhapLaiMatKhau" class="form-label">Nhập lại mật khẩu</label><input asp-for="NhapLaiMatKhau" type="password" class="form-control" autocomplete="new-password" /><span asp-validation-for="NhapLaiMatKhau" class="field-error"></span></div><button class="btn btn-gold btn-lg w-100" type="submit">Đăng ký</button></form><p class="auth-switch">Đã có tài khoản? <a asp-action="Login">Đăng nhập</a></p></div></div></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
