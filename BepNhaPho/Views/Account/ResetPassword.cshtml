@model ResetPasswordViewModel
@{ ViewData["Title"] = "Đặt lại mật khẩu"; }
<section class="auth-section"><div class="container auth-grid"><div class="auth-story"><p class="eyebrow">BẾP NHÀ PHỐ</p><h1>Chọn chiếc chìa khóa<br /><em>mới cho tài khoản.</em></h1></div><div class="auth-card"><p class="eyebrow">MẬT KHẨU MỚI</p><h2>Đặt lại mật khẩu</h2><form asp-action="ResetPassword" method="post"><div asp-validation-summary="ModelOnly" class="validation-summary"></div><input asp-for="MaDatLaiMatKhau" type="hidden" /><div class="mb-3"><label asp-for="MatKhauMoi" class="form-label">Mật khẩu mới</label><input asp-for="MatKhauMoi" type="password" class="form-control" autocomplete="new-password" /><span asp-validation-for="MatKhauMoi" class="field-error"></span></div><div class="mb-4"><label asp-for="NhapLaiMatKhau" class="form-label">Nhập lại mật khẩu</label><input asp-for="NhapLaiMatKhau" type="password" class="form-control" autocomplete="new-password" /><span asp-validation-for="NhapLaiMatKhau" class="field-error"></span></div><button class="btn btn-gold btn-lg w-100" type="submit">Lưu mật khẩu mới</button></form></div></div></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
