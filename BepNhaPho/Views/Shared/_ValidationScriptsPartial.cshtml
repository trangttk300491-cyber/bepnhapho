        jQuery.extend(jQuery.validator.messages, {
            required: 'Vui lòng nhập thông tin bắt buộc.',
            remote: 'Vui lòng kiểm tra lại thông tin này.',
            email: 'Email chưa đúng định dạng.',
            url: 'Đường dẫn chưa đúng định dạng.',
            date: 'Ngày nhập chưa hợp lệ.',
            dateISO: 'Ngày nhập chưa đúng định dạng.',
